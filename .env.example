# Local development PostgreSQL settings (also used by Docker Compose).
POSTGRES_DB=team5
POSTGRES_USER=team5
POSTGRES_PASSWORD=team5
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: SMTP email. Leave the user and password blank to print emails to
# the runserver console instead of sending them.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional: Google SSO credentials from Google Cloud Console.
# Leave blank to hide the Google button without affecting password login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: website assistant (chat widget) powered by Google Gemini.
# Create a key at https://aistudio.google.com/apikey. Leave blank to hide the
# widget. GEMINI_MODEL defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
# Tried when GEMINI_MODEL is overloaded; defaults to gemini-flash-lite-latest.
GEMINI_FALLBACK_MODEL=
# Voice calls (Gemini Live API). Defaults: gemini-3.8-live, the soft female
# voice Achernar (Vindemiatrix, Sulafat, Aoede, and Kore are other female
# voices), and en-US.
GEMINI_LIVE_MODEL=
GEMINI_LIVE_VOICE=
GEMINI_LIVE_LANGUAGE=
# Comma-separated staff emails (Django MANAGERS).
CHATBOT_MANAGER_EMAILS=
# Site admin email the assistant gives when it can't answer a question that
# isn't about an event (defaults to the first manager email).
CHATBOT_SUPPORT_EMAIL=