# Local development PostgreSQL settings (also used by Docker Compose).
POSTGRES_DB=team5
POSTGRES_USER=team5
POSTGRES_PASSWORD=team5
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: Google SSO (credentials from Google Cloud OAuth web application).
# Leave blank to disable the Google button without affecting password login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: website assistant (chat widget) powered by Google Gemini.
# Create a key at https://aistudio.google.com/apikey. Leave blank to hide the
# widget. GEMINI_MODEL defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated staff emails told about questions the assistant can't answer.
CHATBOT_MANAGER_EMAILS=
